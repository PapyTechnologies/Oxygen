{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions pour l'interface locale d'Oxygen",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "allow-tab-show",
    "allow-tab-close",
    "allow-set-top",
    "allow-ai-set-panel-open",
    "allow-action-navigation",
    "allow-active-view-visible",
    "allow-exit-fullscreen",
    "allow-toggle-fullscreen",
    "allow-adblock-count",
    "allow-ram-usage",
    "allow-ram-diagnostic",
    "allow-bookmark-add",
    "allow-bookmark-remove",
    "allow-bookmark-list",
    "allow-history-add",
    "allow-history-list",
    "allow-history-clear",
    "allow-start-stream",
    "allow-stop-stream",
    "allow-stream-status",
    "allow-save-stream-key",
    "allow-delete-stream-key",
    "allow-has-stream-key",
    "allow-list-av-devices",
    "allow-ai-save-key",
    "allow-ai-delete-key",
    "allow-ai-has-key",
    "allow-ai-check-key",
    "allow-ai-chat",
    "allow-ai-get-page",
    "allow-ai-get-config",
    "allow-ai-set-config",
    "allow-ai-list-models",
    "allow-downloads-set-panel-open",
    "allow-downloads-get-history",
    "allow-downloads-clear-history",
    "allow-downloads-remove-item",
    "allow-downloads-open-folder",
    "allow-downloads-get-config",
    "allow-downloads-set-config",
    "allow-downloads-choose-folder"
  ]
}
